<?xml version="1.0" ?>

<sdf version="1.10">
  <world name="pick_test">

    <!-- ========================================================= -->
    <!-- GAZEBO SYSTEMS                                            -->
    <!-- ========================================================= -->

    <plugin
        name="gz::sim::systems::Physics"
        filename="gz-sim-physics-system"/>

    <plugin
        name="gz::sim::systems::UserCommands"
        filename="gz-sim-user-commands-system"/>

    <plugin
        name="gz::sim::systems::SceneBroadcaster"
        filename="gz-sim-scene-broadcaster-system"/>

    <plugin
        name="gz::sim::systems::Contact"
        filename="gz-sim-contact-system"/>

    <!-- Required for cameras -->
    <plugin
        name="gz::sim::systems::Sensors"
        filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>


    <!-- ========================================================= -->
    <!-- LIGHTING                                                  -->
    <!-- ========================================================= -->

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.5 0.5 -1</direction>
    </light>


    <!-- ========================================================= -->
    <!-- PHYSICS                                                   -->
    <!-- ========================================================= -->

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
    </physics>

    <gravity>0 0 -9.81</gravity>


    <!-- ========================================================= -->
    <!-- WAREHOUSE FLOOR                                           -->
    <!-- ========================================================= -->

    <model name="warehouse_floor">
      <static>true</static>

      <link name="floor_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>10 10 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>10 10 0.05</size>
            </box>
          </geometry>

          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- BACK WALL                                                 -->
    <!-- ========================================================= -->

    <model name="back_wall">
      <static>true</static>

      <pose>0 5 2.5 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.10 5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.10 5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- LEFT WALL                                                 -->
    <!-- ========================================================= -->

    <model name="left_wall">
      <static>true</static>

      <pose>-5 0 2.5 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 10 5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 10 5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- RIGHT WALL                                                -->
    <!-- ========================================================= -->

    <model name="right_wall">
      <static>true</static>

      <pose>5 0 2.5 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 10 5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 10 5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- LEFT WAREHOUSE RACK                                       -->
    <!-- ========================================================= -->

    <model name="left_rack">
      <static>true</static>

      <pose>-3.0 1.5 0 0 0 0</pose>

      <link name="rack">

        <!-- Back support -->
        <visual name="back">
          <pose>0 0.35 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.08 3.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>

        <collision name="back_collision">
          <pose>0 0.35 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.08 3.6</size>
            </box>
          </geometry>
        </collision>


        <!-- Shelf 1 -->
        <visual name="shelf1">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.7 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>

        <collision name="shelf1_collision">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.7 0.10</size>
            </box>
          </geometry>
        </collision>


        <!-- Shelf 2 -->
        <visual name="shelf2">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.7 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>

        <collision name="shelf2_collision">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.7 0.10</size>
            </box>
          </geometry>
        </collision>


        <!-- Shelf 3 -->
        <visual name="shelf3">
          <pose>0 0 2.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.7 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>

        <collision name="shelf3_collision">
          <pose>0 0 2.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.7 0.10</size>
            </box>
          </geometry>
        </collision>


        <!-- Vertical posts -->
        <visual name="post1">
          <pose>-1.15 0 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.10 3.6</size>
            </box>
          </geometry>
        </visual>

        <visual name="post2">
          <pose>1.15 0 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.10 3.6</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- RIGHT WAREHOUSE RACK                                      -->
    <!-- ========================================================= -->

    <model name="right_rack">
      <static>true</static>

      <pose>3.0 1.5 0 0 0 0</pose>

      <link name="rack">

        <!-- Back -->
        <visual name="back">
          <pose>0 0.35 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.08 3.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>

        <collision name="back_collision">
          <pose>0 0.35 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.08 3.6</size>
            </box>
          </geometry>
        </collision>


        <!-- Shelves -->
        <visual name="shelf1">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.7 0.10</size>
            </box>
          </geometry>
        </visual>

        <collision name="shelf1_collision">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.7 0.10</size>
            </box>
          </geometry>
        </collision>


        <visual name="shelf2">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.7 0.10</size>
            </box>
          </geometry>
        </visual>

        <collision name="shelf2_collision">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.7 0.10</size>
            </box>
          </geometry>
        </collision>


        <visual name="shelf3">
          <pose>0 0 2.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.7 0.10</size>
            </box>
          </geometry>
        </visual>

        <collision name="shelf3_collision">
          <pose>0 0 2.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.7 0.10</size>
            </box>
          </geometry>
        </collision>


        <!-- Posts -->
        <visual name="post1">
          <pose>-1.15 0 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.10 3.6</size>
            </box>
          </geometry>
        </visual>

        <visual name="post2">
          <pose>1.15 0 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.10 3.6</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- PALLET                                                   -->
    <!-- ========================================================= -->

    <model name="pallet">
      <static>true</static>

      <pose>1.8 0.8 0.08 0 0 0</pose>

      <link name="pallet_link">

        <visual name="top">
          <geometry>
            <box>
              <size>1.2 1.0 0.15</size>
            </box>
          </geometry>

          <material>
            <ambient>0.45 0.25 0.08 1</ambient>
            <diffuse>0.60 0.35 0.12 1</diffuse>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 1.0 0.15</size>
            </box>
          </geometry>
        </collision>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- BOXES ON PALLET                                          -->
    <!-- ========================================================= -->

    <model name="box_1">
      <static>true</static>
      <pose>1.55 0.65 0.40 0 0 0</pose>

      <link name="link">

        <visual name="visual">
          <geometry>
            <box>
              <size>0.35 0.35 0.50</size>
            </box>
          </geometry>

          <material>
            <ambient>0.55 0.30 0.10 1</ambient>
            <diffuse>0.70 0.40 0.15 1</diffuse>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.35 0.35 0.50</size>
            </box>
          </geometry>
        </collision>

      </link>
    </model>


    <model name="box_2">
      <static>true</static>
      <pose>1.95 0.65 0.40 0 0 0</pose>

      <link name="link">

        <visual name="visual">
          <geometry>
            <box>
              <size>0.35 0.35 0.50</size>
            </box>
          </geometry>

          <material>
            <ambient>0.55 0.30 0.10 1</ambient>
            <diffuse>0.70 0.40 0.15 1</diffuse>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.35 0.35 0.50</size>
            </box>
          </geometry>
        </collision>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- EXISTING CYLINDER                                        -->
    <!-- ========================================================= -->

    <model name="cylinder_1">

      <pose>-0.30 -0.12 0.10 0 0 0</pose>

      <link name="link">

        <inertial>
          <mass>0.2</mass>

          <inertia>
            <ixx>0.0008667</ixx>
            <iyy>0.0008667</iyy>
            <izz>0.00064</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.1 0.4 0.8 1</ambient>
            <diffuse>0.2 0.6 1.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>

        </visual>

      </link>
    </model>


  </world>
</sdf>